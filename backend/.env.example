ENV=development
DEBUG=true
DEMO_MODE=true
APP_NAME=KrishiLink API
APP_VERSION=2.0.0
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
DATABASE_URL=postgresql+psycopg://krishilink:krishilink@localhost:5435/krishilink
REDIS_URL=redis://localhost:6380/0
JWT_SECRET=dev-only-change-in-production-32chars!!
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
OTP_CODE_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
# Development-only; the API also requires ENV=development before exposing an OTP.
OTP_DEVELOPMENT_CODE_EXPOSURE_ENABLED=true
AUTH_PASSWORD_MIN_LENGTH=10
PAYMENT_PROVIDER=mock
LOG_LEVEL=INFO
TRUSTED_PROXIES=127.0.0.1,::1,localhost
INTELLIGENCE_FORECASTS_ENABLED=false
INTELLIGENCE_PRICE_ALERTS_ENABLED=true
WEB_PUSH_ENABLED=false
# VAPID public key may be shared with the browser. Private key stays server-side.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.invalid
WEB_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com
INTELLIGENCE_TRUST_SUMMARIES_ENABLED=true
INTELLIGENCE_DESCRIPTIVE_MOVE_THRESHOLD_PCT=1.5

# Government Mandi Price API (data.gov.in / Agmarknet)
AGMARKNET_API_KEY=
MANDI_API_KEY=

# SMS Notification Configuration
SMS_ENABLED=false
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=your_fast2sms_authorization_key_here
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_FLOW_ID=your_msg91_flow_id_here
SMS_DEFAULT_COUNTRY_CODE=+91

# Android SMS Gateway (SMSGate) Configuration
SMSGATE_BASE_URL=https://api.sms-gate.app
SMSGATE_USERNAME=your_smsgate_username
SMSGATE_PASSWORD=your_smsgate_password
SMSGATE_DEVICE_ID=your_device_id_optional
SMSGATE_SIM_NUMBER=1
SMSGATE_TIMEOUT_SECONDS=15

